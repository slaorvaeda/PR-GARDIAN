# PR-Guardian Environment Configuration

# Server Ports
PORT=5001
AI_ENGINE_PORT=8000
FRONTEND_PORT=3000

# PostgreSQL + pgvector
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=pr_guardian
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/pr_guardian

# MongoDB (Raw webhooks, diffs, traces)
MONGODB_URI=mongodb://localhost:27017/pr_guardian

# AI / LLM Configuration (Set at least one, or leave blank for intelligent heuristic simulation mode)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=gemini-1.5-flash

# GitHub Integration (Optional for local testing / simulator)
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=dev_secret

# AI Engine Service URL (Used by Node.js backend)
AI_ENGINE_URL=http://localhost:8000
BACKEND_URL=http://localhost:5001
